    <string name="app_name">Everheard</string>
    <string name="onboarding_kicker">EVERHEARD · 首次启动</string>
    <string name="onboarding_title">把说过的话，留下来。</string>
    <string name="onboarding_body">Everheard 把你参与的对话变成文字、承诺和项目时间线。它不保留原始录音。</string>
    <string name="onboarding_visible_title">可见的采集</string>
    <string name="onboarding_visible_body">常驻通知 + 开始提示音。没有隐蔽模式。</string>
    <string name="onboarding_text_title">只留文字，不留声音</string>
    <string name="onboarding_text_body">转写完成后删除音频。数据库用 Android Keystore 中的密钥加密。</string>
    <string name="onboarding_sleep_title">睡眠时段</string>
    <string name="onboarding_sleep_body">全天待命，但默认 23:30–07:00 暂停。之后可以随时修改时段。</string>
    <string name="onboarding_consent">我明白：我只能录制法律允许我录制的对话。</string>
    <string name="onboarding_legal_button">阅读法律说明</string>
    <string name="onboarding_continue">继续</string>
    <string name="onboarding_footer">这些设置之后都可以在「设置」里修改。</string>

    <string name="legal_title">录音与同意</string>
    <string name="legal_body">在一方同意地区，你可以录制自己参与的对话。录制不属于你的旁人对话不受这条保护；有些地区要求所有参与者同意。采集期间 Everheard 会显示通知并播放提示音。同意责任由你承担。</string>
    <string name="legal_confirm">我明白了</string>

    <string name="permission_microphone_title">需要麦克风权限</string>
    <string name="permission_microphone_body">Everheard 需要麦克风把语音转成文字。采集状态会一直显示在通知栏。</string>
    <string name="permission_microphone_action">允许麦克风</string>
